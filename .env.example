# =============================================================================
# 🔒 SECRET KEYS (SERVER-ONLY — NEVER EXPOSE TO BROWSER OR CLIENT JAVASCRIPT)
# DO NOT add the NEXT_PUBLIC_ prefix to any of the variables in this section.
# =============================================================================

# Neon Serverless PostgreSQL Connection String (Pooler or Direct)
# Get from https://console.neon.tech -> Connection Details
DATABASE_URL=postgresql://user:password@ep-project-id.region.aws.neon.tech/dbname?sslmode=require

# Application Auth Secret (min 32 characters, used to sign session JWTs)
AUTH_SECRET=your-secret-key-at-least-32-characters-long

# Neon Managed Better Auth Secrets
NEON_AUTH_BASE_URL=https://ep-project-id.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=your-neon-cookie-secret-key

# Neon S3-Compatible Object Storage Credentials
AWS_ENDPOINT_URL_S3=https://your-storage-endpoint.storage.region.aws.neon.tech
AWS_ACCESS_KEY_ID=your-neon-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-neon-s3-secret-access-key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-bucket-name

# Super Admin Console Authorization (/admin)
ADMIN_SECRET=your-secure-admin-master-password
ADMIN_EMAIL=admin@yourfirm.com,coadmin@yourfirm.com

# Background Retention & Auto-Purge Cron Secret (/api/cron/cleanup-storage)
CRON_SECRET=your-secure-cron-trigger-secret

# Transactional Email Delivery via Resend (Optional)
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=DocuCollect <noreply@yourdomain.com>

# Google OAuth Credentials (Optional)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret


# =============================================================================
# 🌐 PUBLIC KEYS (CLIENT-ACCESSIBLE — SAFE FOR BROWSER / NEXT_PUBLIC_ PREFIX)
# These variables are baked into client-side bundles and visible to all visitors.
# =============================================================================

# Base Application URL (used for absolute URLs, WhatsApp share links, sitemaps)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Neon Better Auth Endpoint (used by client-side Google OAuth buttons)
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-project-id.neonauth.region.aws.neon.tech/neondb/auth

# Public Billing & UPI Payment Instructions (Displayed in Billing Dashboard)
NEXT_PUBLIC_UPI_ID=yourname@bank
NEXT_PUBLIC_BANK_NAME=State Bank of India
NEXT_PUBLIC_BANK_HOLDER=DocuCollect Technologies
NEXT_PUBLIC_BANK_ACCOUNT=3982001100234
NEXT_PUBLIC_BANK_IFSC=SBIN0001234

# Public Support Contact Details
NEXT_PUBLIC_CONTACT_EMAIL=support@docucollect.in
NEXT_PUBLIC_CONTACT_PHONE=+919876543210
